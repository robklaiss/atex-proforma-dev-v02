Options -Indexes
DirectoryIndex index.php

RewriteEngine On

RewriteRule ^(?:app|docs|migrations|scripts|storage|tests)(?:/|$) - [F,L]
RewriteRule ^(?:README\.md|screenlog\.0|\.env(?:\..*)?|\.git(?:/|$)|\.codex(?:/|$)|\.agents(?:/|$)) - [F,L,NC]
RewriteRule ^Proforma.*\.pdf$ - [F,L]
RewriteRule \.(?:sqlite|sql)$ - [F,L]

RewriteRule ^public/?$ public/index.php [L]
RewriteRule ^public/ - [L]
RewriteRule ^$ public/index.php [L]
RewriteRule ^(.+)$ public/$1 [L,QSA]
